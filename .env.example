# Copie para .env e preencha a chave. Nunca faça commit do .env.

# Obrigatória para a camada 2 do checador e para o classificador
ANTHROPIC_API_KEY=

# Banco
PROMESSA_DB_URL=sqlite:///var/promessa.db

# Modelos
CHECKER_MODEL=claude-sonnet-5-5
CLASSIFIER_MODEL=claude-haiku-5-5
EXPLAINER_MODEL=claude-haiku-5-5

# Comportamento do modelo
CHECKER_USE_LLM=true
LLM_OFFLINE=false
LLM_CACHE_DIR=.cache/llm

# Limiares
CONFIDENCE_THRESHOLD=0.8
MIN_SALES_FOR_INDICATOR=30
URGENCY_STALE_DAYS=7

# Link fictício
LINK_BASE_URL=https://youshop.example/l/
